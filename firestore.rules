rules_version = '2';

// Reglas de seguridad de Rutix (RNF-03 y RNF-04).
// - Cada usuario solo lee su propio perfil; el administrador lee y edita todos.
// - Nadie puede darse a sí mismo el rol de conductor o administrador.
// - Trabajadores y conductores solo ven la ruta y el recorrido de SU ruta.
// - Solo el conductor asignado a una ruta puede publicar su ubicación.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return conSesion() && perfil().rol == 'admin';
    }

    function esDeLaRuta(rutaId) {
      return conSesion() && perfil().get('rutaId', null) == rutaId;
    }

    function esConductorDe(rutaId) {
      return esDeLaRuta(rutaId) && perfil().rol == 'conductor';
    }

    match /usuarios/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esAdmin());

      // Registro: siempre como trabajador y sin ruta asignada.
      allow create: if conSesion()
        && request.auth.uid == uid
        && request.resource.data.rol == 'trabajador'
        && request.resource.data.get('rutaId', null) == null
        && request.resource.data.get('paradaIdx', null) == null
        && request.resource.data.get('codigoQr', null) == null;

      // El usuario puede editar sus datos, pero no su rol, ruta, parada ni QR.
      allow update: if esAdmin()
        || (conSesion() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['rol', 'rutaId', 'paradaIdx', 'codigoQr']));

      allow delete: if esAdmin();
    }

    match /rutas/{rutaId} {
      allow read: if esAdmin() || esDeLaRuta(rutaId);
      allow write: if esAdmin();

      // Trabajadores asignados y token de su QR (RF-05 y RF-06).
      // Los otros trabajadores nunca los ven.
      match /pasajeros/{uid} {
        allow read: if esAdmin() || esConductorDe(rutaId);
        allow write: if esAdmin();
      }

      // Abordajes: id = {aaaa-mm-dd}_{uid}, uno por trabajador y día.
      match /abordajes/{abordajeId} {
        allow read: if esAdmin()
          || esConductorDe(rutaId)
          || (conSesion() && abordajeId.split('_')[1] == request.auth.uid);

        // Solo el conductor de la ruta, con el token correcto del QR.
        // Como no hay regla de update, un segundo escaneo el mismo día falla.
        allow create: if esConductorDe(rutaId)
          && request.resource.data.conductorUid == request.auth.uid
          && abordajeId == request.resource.data.fecha + '_' + request.resource.data.uid
          && get(/databases/$(database)/documents/rutas/$(rutaId)/pasajeros/$(request.resource.data.uid)).data.token
               == request.resource.data.token;

        allow delete: if esAdmin();
      }
    }

    match /recorridos/{rutaId} {
      allow read: if esAdmin() || esDeLaRuta(rutaId);

      // El conductor de la ruta escribe su propio recorrido.
      allow create, update: if esAdmin()
        || (esConductorDe(rutaId)
            && request.resource.data.conductorUid == request.auth.uid);

      allow delete: if esAdmin();
    }
  }
}
